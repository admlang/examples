// Calls .NET from ADM: a shop keeps its pricing rules in a C# class, and the
// program calls its static methods like its own functions. It also makes a
// .NET object and hands .NET one of its own functions.
//
//   adm get                                 (once: fetches the library adm.toml names)
//   dotnet build interop/dotnet -o interop/dotnet/bin
//   adm run interop/dotnet/main.adm

// The declarations of Pricing.cs. A function without a body under `@dotnet`
// is the static method of the same name with a capital first letter: int32
// is int, float is double, a string is a string, an array of numbers or
// strings is the .NET array.
module pricing {
	use adm.interop.dotnet::*

	@dotnet("Shop.Pricing")
	def total(prices float[], quantities int32[], customer string) !float;

	@dotnet("Shop.Pricing")
	def discount(customer string) !float;

	@dotnet("Shop.Pricing")
	def labels(prices float[], currency string) !string[];

	// .NET returns null for an unknown code, which arrives as none.
	@dotnet("Shop.Pricing")
	def coupon(code string) !?string;

	// .NET throws for an order below the minimum, which arrives as an
	// error. `check` is a keyword in ADM, so the declaration has another
	// name.
	@dotnet("Shop.Pricing", method = "Check")
	def checkOrder(total float) !none;
}

application Interop {
	use (
		adm.interop.dotnet
		pricing
	)

	// The program's entry point.
	def new(args string[]) int {
		run() onerror (err error) {
			println("failed: {err.message}")
			recover none
		}
		return 0
	}

	def run() !none {
		// The folder the assembly was built into.
		try dotnet.runtime().start(folders = ["interop/dotnet/bin"])

		let prices float[] = [19.90, 5.00, 120.00]
		let quantities int32[] = [2, 1, 1]
		let customer = "ana@partner.example"

		println("labels    {(try pricing.labels(prices, "EUR")).join(", ")}")
		println("discount  {try pricing.discount(customer)}")
		println("total     {try pricing.total(prices, quantities, customer)}")

		let known = try pricing.coupon("WELCOME")
		println("coupon    {known}") unless known is none
		let unknown = try pricing.coupon("SUMMER")
		println("coupon    none for SUMMER") when unknown is none

		pricing.checkOrder(4.5) onerror (err error) {
			println("refused   {err.message}")
			if err is dotnet.ScriptError {
				let thrown = err.value
				if !(thrown is none) {
					let reason = thrown.get("Message") onerror recover thrown
					println("          .NET says: {reason}")
				}
			}
			recover none
		}

		// A .NET object, made and called from here: a list, sorted by an
		// ADM function that .NET calls as its Comparison.
		let clr = dotnet.runtime()
		let names = try (try clr.load("System.Collections.Generic.List`1[System.String]")).construct()
		for let (_, name) in ["pear", "fig", "banana"] {
			try names.invoke("Add", name)
		}
		let byLength = try clr.function(def (args dotnet.Value[]) !dotnet.Value {
			return try clr.value((try args[0].asString()).len() - (try args[1].asString()).len())
		})
		try names.invoke("Sort", byLength)
		println("sorted    {try (try clr.load("string")).invoke("Join", ", ", names)}")
		return none
	}
}
