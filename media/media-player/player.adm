// Plays audio and video files and internet radio in a window, one after
// another. A video shows its picture; an audio file or a radio station
// shows level bars moving with the sound.
//
//   adm run --release media/media-player/player.adm -- song.mp3 clip.mp4
//   adm run --release media/media-player/player.adm -- ~/Music
//   adm run --release media/media-player/player.adm -- https://live.kissfm.ro/kissfm.aacp
//
// A folder adds every audio and video file in it; an address starting with
// http:// or https:// is a radio station, or a file on a server. Keys:
//
//   space          pause and resume
//   n, p           next and previous file
//   right, left    skip 10 seconds forward and back
module mediaplayer.components {
	use (
		std.formats.image::(Image)
		std.gfx.color::(Color)
		std.math.geom::Rect
		std.media.player::(MediaPlayer, PlayerState)
		std.ui::(Key, KeyEvent, RenderContext)
		std.ui.styles::*
	)

	// The style of the `Screen`: its box.
	style Fill {
		Box
	}

	// The window's content: the video's picture, or the image the player draws into
	// while an audio file plays. It takes the keys that steer the player.
	component Screen {
		type {
			@input
			player MediaPlayer = new MediaPlayer()

			// What the player draws into while an audio file plays.
			@input
			screen Image = new Image(800, 600)

			def new() {
				style.width = fill
				style.height = fill
			}

			// Does what a key asks of the player. A player that cannot start, change
			// file or skip says why and goes on: a radio stream has no earlier or later
			// to skip to.
			def key(e KeyEvent) bool {
				match e.key {
					case Key.Space:
						if player.state() == PlayerState.Playing {
							player.pause()
						} else {
							player.play() onerror (err error) {
								println("cannot play: {err.message}")
								recover none
							}
						}
					case Key.N:
						player.next() onerror (err error) {
							println("no next file: {err.message}")
							recover none
						}
					case Key.P:
						player.previous() onerror (err error) {
							println("no previous file: {err.message}")
							recover none
						}
					case Key.Right:
						player.skip(10s) onerror recover none
					case Key.Left:
						player.skip(-10s) onerror recover none
					default:
						return false
				}
				return true
			}

			def render(ctx RenderContext) {
				let frame = ctx.geometry.frame
				let (width, height) = (int(float(frame.width)), int(float(frame.height)))
				ctx.draw.fill(Rect{left: 0.0, top: 0.0, right: float(width), bottom: float(height)}, new Color("#000000"))
				// Another frame follows this one: the picture and the bars keep moving.
				redraw()

				// `picture` is the video frame due now, or none for an audio file.
				let picture = player.picture()
				if picture is none {
					// The visualizer's image, centred in the window.
					ctx.draw.blit(screen, ((width - 800) / 2).max(0), ((height - 600) / 2).max(0))
				} else {
					// The video frame, scaled to fit the window.
					ctx.draw.drawVideo(picture, 0, 0, width, height)
				}
			}
		}

		view {}

		style Fill
	}
}

application mediaPlayer {
	use (
		std.formats.image::(Image)
		std.media.player::(LevelBarsVisualizer, MediaPlayer)
		std.os
		std.ui::(UI, UIConfig)
		std.ui.renderer::(WindowConfig)
		mediaplayer.components::Screen
	)

	// The program's entry point: every argument is a file, a folder or an
	// internet address to play. Fails when a folder cannot be read, the
	// window cannot be opened, or playback cannot start (no speaker).
	async def new(args string[]) !int {
		if args.len() < 2 {
			println("usage: player FILE-OR-FOLDER-OR-ADDRESS...")
			return 1
		}

		let player = new MediaPlayer()
		for let (_, path) in args[1:] {
			// An internet address goes in as it is: the player connects to it
			// when its turn comes.
			if path.startsWith("http://") || path.startsWith("https://") {
				player.playlist.push(path)
				continue
			}
			let info = try os.stat(path)
			if info.isDir {
				_ = try player.playlist.addFolder(path)
			} else {
				player.playlist.push(path)
			}
		}
		println("{player.playlist.len()} item(s) to play")

		// The player draws into `screen` while an audio file plays: the
		// visualizer when it has one, else the file's cover art.
		let screen = new Image(800, 600)
		player.display = screen
		player.visualizer = new LevelBarsVisualizer()

		// The player runs on its own task and reports through these functions.
		player.onTrackChange = def (index int) {
			println("playing {player.playlist.tracks[index].location}") when index >= 0
		}
		// A radio station sends its name when the connection opens and a line
		// of text each time a new song starts; the player puts them in the
		// track's title and artist.
		player.onTitleChange = def (index int) {
			return when index < 0
			let track = player.playlist.tracks[index]
			if track.artist == "" {
				println("  {track.title}")
			} else {
				println("  {track.artist}: {track.title}")
			}
		}
		player.onError = def (index int, err error) {
			println("cannot play {player.playlist.tracks[index].location}: {err.message}")
		}
		try player.play()

		try UI.config(UIConfig{rendererName: "opengl"})
		try await UI.start()
		// `run` draws the component in the window, hands it the keys, and returns when
		// the window is closed.
		try await UI.run(Screen(player = player, screen = screen), new WindowConfig("ADM media player", 800, 600))
		player.stop()
		return 0
	}
}
