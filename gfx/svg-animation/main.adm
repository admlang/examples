// Plays an animated SVG in a window, scaled to fit, until the window is
// closed. Given an output directory, it writes the animation as PNG frames
// instead, without a window.
//
//   adm run gfx/svg-animation/main.adm                                plays orbit.svg
//   adm run gfx/svg-animation/main.adm -- some.svg                    plays another file
//   adm run gfx/svg-animation/main.adm -- some.svg frames/            writes 10 seconds of frames
//   adm run gfx/svg-animation/main.adm -- some.svg frames/ 3          writes 3 seconds
//
// Frames are written at 25 a second, as frames/frame-0000.png and on.
module svganimation.components {
	use (
		std.formats.image::(SVG)
		std.gfx.color::(Color)
		std.math.geom::Rect
		std.time
		std.ui::RenderContext
		std.ui.styles::*
	)

	// The style of the `Animation`: its box.
	style Fill {
		Box
	}

	// The window's content: the document as it shows now, scaled to fit and centred.
	component Animation {
		type {
			// The SVG document, and the size it asks to be drawn at.
			@input
			data byte[] = []

			@input
			width float = 1.0

			@input
			height float = 1.0

			svg   SVG = new SVG()
			// When the animation started.
			start time.Time
			// Whether a frame could not be drawn and that was said.
			failed bool

			def new() {
				style.width = fill
				style.height = fill
				start = time.now()
			}

			def render(ctx RenderContext) {
				let frame = ctx.geometry.frame
				let (viewWidth, viewHeight) = (float(frame.width), float(frame.height))
				ctx.draw.fill(Rect{left: 0.0, top: 0.0, right: viewWidth, bottom: viewHeight}, new Color("#FFFFFF"))
				// Another frame follows this one: the animation goes on.
				redraw()
				// The document as it shows at this moment, as a recording of drawing
				// commands rather than pixels, so it stays sharp at any window size.
				let picture = svg.picture(data, time.now().since(start)) onerror (err error) {
					// Said once: the window stays white.
					println("cannot draw the document: {err.message}") unless failed
					failed = true
					return
				}
				let scale = (viewWidth / width).min(viewHeight / height)
				ctx.draw.save()
				ctx.draw.translate((viewWidth - width * scale) / 2.0, (viewHeight - height * scale) / 2.0)
				ctx.draw.scale(scale, scale)
				picture.replay(ctx.draw)
				ctx.draw.restore()
			}
		}

		view {}

		style Fill
	}
}

application SvgAnimation {
	use (
		std.formats.image::(SVG)
		std.os
		std.ui::(UI, UIConfig)
		std.ui.renderer::(WindowConfig)
		svganimation.components::Animation
	)

	// The program's entry point: `args[1]` is the SVG file, `args[2]` an
	// output directory and `args[3]` a number of seconds, all optional.
	// Fails when the file cannot be read or is not an SVG document, the
	// window cannot be opened, or a frame cannot be written.
	async def new(args string[]) !int {
		let path = args.len() > 1 ?? (args[1], "./orbit.svg")
		if args.len() > 2 {
			let seconds = args.len() > 3 ?? (args[3].toInt<int>(), 10)
			try writeFrames(path, args[2], seconds)
		} else {
			try await play(path)
		}
		return 0
	}

	// Shows the document at `path` in a window until the window is closed.
	// Fails when the file cannot be read or is not an SVG document, or the
	// window cannot be opened.
	async def play(path string) !none {
		let data = try os.readFile(path)
		let svg = new SVG()
		// The size the document asks to be drawn at.
		let info = try svg.info(data)
		let (width, height) = (info.size.width, info.size.height)
		// Read once here, so a document that cannot be drawn fails before a window opens.
		let _ = try svg.picture(data)

		try UI.config(UIConfig{rendererName: "opengl"})
		try await UI.start()
		// `run` draws the component in the window and returns when it is closed.
		try await UI.run(Animation(data = data, width = width, height = height), new WindowConfig("{os.base(path)} — SVG animation", width, height))
		return none
	}

	// Writes the first `seconds` of the animation into `dir` as numbered
	// PNG files, 25 for each second. Fails when the file cannot be read or
	// is not an SVG document, or a frame cannot be written.
	def writeFrames(path string, dir string, seconds int) !none {
		let rate = 25
		let svg = new SVG()
		// `mkdir` fails when the directory is already there, which is fine.
		os.mkdir(dir) onerror recover none

		for let i = 0; i < seconds * rate; i++ {
			// `decode` with a time draws the document as it shows then.
			let img = try svg.decode(path, 1s * (float(i) / float(rate)))
			try img.save(os.join(dir, "frame-{i.str().padStart(4, "0")}.png"))
		}
		println("{seconds * rate} frames written to {dir}")
		return none
	}
}
