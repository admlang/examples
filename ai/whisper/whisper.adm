// Writes down the speech in a sound file with a Whisper model.
//
//   adm run --release ai/whisper/whisper.adm -- MODEL_DIR SOUND_FILE [LANGUAGE]
//
// MODEL_DIR is a Whisper export like onnx-community/whisper-base. LANGUAGE
// is a code like `en`; without one the model finds the language itself.
application whisper {
	use (
		std.time
		std.formats.audio
		std.ai.speech
	)

	def new(args string[]) !int {
		if args.len() < 3 {
			println("usage: whisper MODEL_DIR SOUND_FILE [LANGUAGE]")
			return 0
		}
		let model = try speech.load(args[1], language = args.len() > 3 ?? (args[3], ""))
		let started = time.now()
		println(try model.transcribe(try audio.load(args[2])))
		println("({time.since(started).seconds()} s on {model.device()})")
		return 0
	}
}
